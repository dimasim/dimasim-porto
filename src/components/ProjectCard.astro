---
interface Props {
  title: string;
  year?: string;
  description?: string;
  highlights?: string[];
  tags: string[];
  image?: string;
  link?: string;
  github?: string;
  category?: string;
}

const { 
  title, 
  year, 
  description, 
  highlights = [], 
  tags, 
  image, 
  link, 
  github,
  category = "Proyek Unggulan"
} = Astro.props;

const hasLink = Boolean(link && link !== "#");
const hasGithub = Boolean(github && github !== "#");
---

<div class="project-card glass">
  <div class="project-media">
    {image ? (
      <img src={image} alt={title} class="project-img" loading="lazy" />
    ) : (
      <div class="project-placeholder">
        <div class="placeholder-pattern"></div>
        <div class="placeholder-icon">⚡</div>
        <span class="placeholder-category">{category} {year ? `· ${year}` : ''}</span>
      </div>
    )}
    {year && <span class="year-pill">{year}</span>}
  </div>

  <div class="project-content">
    <div class="title-row">
      <span class="category-tag">{category}</span>
      <h3>{title}</h3>
    </div>

    {description && <p class="project-desc">{description}</p>}

    {highlights.length > 0 && (
      <ul class="highlights-list">
        {highlights.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    )}

    <div class="tags">
      {tags.map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>

    <div class="project-actions">
      {hasLink ? (
        <a href={link} class="btn-primary btn-sm" target="_blank" rel="noopener noreferrer">
          Live Demo ↗
        </a>
      ) : null}

      {hasGithub ? (
        <a href={github} class="btn-outline btn-sm" target="_blank" rel="noopener noreferrer">
          GitHub Repo ↗
        </a>
      ) : null}

      {!hasLink && !hasGithub ? (
        <div class="status-note">
          <span class="dot"></span>
          <span>Detail Teknis / Selesai</span>
        </div>
      ) : null}
    </div>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    height: 100%;
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-purple);
    box-shadow: 0 16px 36px -12px rgba(139, 92, 246, 0.35);
  }

  .project-media {
    position: relative;
    width: 100%;
    height: 180px;
    background: #111827;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.05);
  }

  .project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.95));
  }

  .placeholder-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(14, 165, 233, 0.15) 1px, transparent 1px);
    background-size: 16px 16px;
    opacity: 0.7;
  }

  .placeholder-icon {
    font-size: 2.5rem;
    margin-bottom: 8px;
    z-index: 1;
    filter: drop-shadow(0 0 12px var(--accent-neon));
  }

  .placeholder-category {
    font-size: 0.8rem;
    color: var(--accent-neon);
    z-index: 1;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .year-pill {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .project-content {
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .title-row {
    margin-bottom: 12px;
  }

  .category-tag {
    font-size: 0.75rem;
    color: var(--accent-purple);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }

  h3 {
    font-size: 1.35rem;
    color: #fff;
    line-height: 1.3;
  }

  .project-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .highlights-list li {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    position: relative;
    padding-left: 18px;
  }

  .highlights-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent-neon);
    font-weight: bold;
    font-size: 0.85rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tag {
    font-size: 0.75rem;
    padding: 3px 10px;
    background: rgba(14, 165, 233, 0.08);
    color: var(--accent-neon);
    border-radius: 6px;
    border: 1px solid rgba(14, 165, 233, 0.2);
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .status-note {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .status-note .dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
  }

  .btn-sm {
    padding: 8px 16px;
    font-size: 0.85rem;
  }
</style>
